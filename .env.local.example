# ==============================================================================
# Campus Career Copilot — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials:
# cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Browser & Server)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Cloud Messaging (FCM) Web Push Certificate (VAPID Public Key)
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNYourWebPushVapidPublicKeyHereFromFirebaseConsole

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-only)
# Obtain from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Paste the entire JSON file as a SINGLE-LINE escaped string
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"1234567890","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com"}

# ------------------------------------------------------------------------------
# 3. Edge Middleware HMAC Security Secret (Edge Runtime & Server)
# High-entropy random secret (at least 32 characters) for signing the session_role cookie
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
SESSION_ROLE_SECRET=your-random-256-bit-hmac-secret-string-at-least-32-chars

# ------------------------------------------------------------------------------
# 4. Supabase PostgreSQL Configuration (Server-only)
# Obtain from Supabase Dashboard -> Project Settings -> API
# Note: SUPABASE_SERVICE_ROLE_KEY bypasses RLS and is used by server route handlers
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Configuration (Server-only)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Uses model: gemini-3.5-flash-lite
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere

# Optional dedicated Gemini API key for LaTeX resume builder (falls back to GEMINI_API_KEY if unset)
GEMINI_RESUME_BUILDER_API_KEY=AIzaSyYourGoogleGeminiResumeBuilderApiKeyHere

# ------------------------------------------------------------------------------
# 6. Institutional Registration Invite Codes (Server-only)
# Codes required during signup at /signup to assign Student or TPO roles
# ------------------------------------------------------------------------------
STUDENT_INVITE_CODE=CAMPUS2026
TPO_INVITE_CODE=ADMIN2026
